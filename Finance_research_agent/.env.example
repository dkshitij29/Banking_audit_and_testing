# ── LLM Provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
VLLM_BASE_URL=http://0.0.0.0:9000/v1

# ── Data Providers ───────────────────────────────────────────────────────────
FMP_API_KEY=
FINNHUB_API_KEY=

# ── India Market (required for /api/aoc4/* and market=IN) ────────────────────
# Set these to enable Indian market analysis.
# IN_RISK_FREE_RATE = 10-year G-sec yield as decimal (e.g. 0.073 for 7.3%)
# IN_EQUITY_RISK_PREMIUM = decimal (e.g. 0.060 for 6.0%)
# If unset, India valuation endpoints return HTTP 503.
# IN_RISK_FREE_RATE=
# IN_EQUITY_RISK_PREMIUM=
IN_DEFAULT_TAX_RATE=0.2517
IN_TERMINAL_GROWTH_CAP=0.05
IN_MAX_FINANCIALS_AGE_DAYS=456

# ── Feature Flags ────────────────────────────────────────────────────────────
UNLISTED_DLOM=0.20
UNLISTED_CAPITAL_STRUCTURE=peer_median
VERDICT_GATING_ENABLED=true
MAX_METHOD_DIVERGENCE=0.50
ALLOW_LLM_CLASSIFIER=false
ALLOW_LLM_EXTRACTION=false
OCR_ENABLED=true
MAX_UPLOAD_FILES=40
MAX_UPLOAD_MB=150
MAX_PDF_PAGES=400
PIPELINE_TIMEOUT_S=120
