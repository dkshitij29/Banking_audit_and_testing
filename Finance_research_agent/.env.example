# LLM (pick one provider)
LLM_PROVIDER=openai                    # openai | anthropic | vllm
LLM_MODEL=gpt-4o                       # gpt-4o | claude-sonnet-4-6 | Qwen3.6-27B

# API keys (provider-specific, loaded via keyring in desktop)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# vLLM (local OpenAI-compatible endpoint, no API key needed)
VLLM_BASE_URL=http://0.0.0.0:9000/v1

# Data providers (optional, for richer financials)
FMP_API_KEY=                           # Financial Modeling Prep
FINNHUB_API_KEY=                       # Finnhub news

# Paths
UPLOAD_DIR=./upload
OUTPUT_DIR=./output
