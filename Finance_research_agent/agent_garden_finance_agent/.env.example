# Finance agent settings. Copy this file to TradingAgents/.env and fill in the values.
# Never commit the real .env: it holds your contact e-mail and any API keys.

# --- Model server (vLLM, OpenAI-compatible, reached through start_tunnel.ps1) ---
TRADINGAGENTS_LLM_PROVIDER=openai_compatible
# Qwen3.6-27B is served on port 9000, gemma-4-12B on port 9003
TRADINGAGENTS_LLM_BACKEND_URL=http://localhost:9000/v1
TRADINGAGENTS_DEEP_THINK_LLM=Qwen3.6-27B
TRADINGAGENTS_QUICK_THINK_LLM=Qwen3.6-27B
# Retry a model call up to 6 times instead of failing a decision when the tunnel reconnects
TRADINGAGENTS_LLM_MAX_RETRIES=6

# --- Where logs and reports are written (absolute paths) ---
TRADINGAGENTS_RESULTS_DIR=<path to this folder>/results
TRADINGAGENTS_MEMORY_LOG_PATH=<path to this folder>/results/memory/trading_memory.md

# --- Data sources ---
# SEC EDGAR asks every client to identify itself with a name and a contact e-mail (no key)
SEC_EDGAR_USER_AGENT=<Your Name> <your e-mail>
# FRED macro data: free key from https://fred.stlouisfed.org/docs/api/api_key.html (off in our runs)
# FRED_API_KEY=<your FRED key>

# --- Optional: extra technical indicators for the market analyst (off by default, ADR-005) ---
# TRADINGAGENTS_EXTRA_INDICATORS=true

# --- Lab login for start_tunnel.ps1 (set these as environment variables in PowerShell) ---
# $env:LAB_SSH_USER = "<your lab user>"
# $env:LAB_SSH_HOST = "<lab login host>"
# $env:LAB_SSH_KEY  = "$HOME\.ssh\<your key file>"
